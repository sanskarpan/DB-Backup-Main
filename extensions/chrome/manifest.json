{
  "manifest_version": 3,
  "name": "DB Backup Manager",
  "version": "1.0.0",
  "description": "Enterprise-grade database backup management directly from your browser. Quick backups, real-time monitoring, and instant notifications.",
  "author": "DB Backup Manager Team",
  "homepage_url": "https://github.com/yourusername/db-backup",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "DB Backup Manager"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "https://*/*"
  ],

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open DB Backup Manager"
    },
    "quick_backup": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Quick backup"
    },
    "view_backups": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "View backups"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "shared/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
