# ⚠️ WARNING: This is a TEMPLATE file for Kubernetes secrets
# DO NOT commit actual secrets to version control!
#
# USAGE:
# 1. Copy this file: cp secret.yaml.example secret.yaml
# 2. Replace ALL placeholder values with real secrets
# 3. Ensure secret.yaml is in .gitignore
# 4. For production, use external secret management:
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Google Secret Manager
#    - Sealed Secrets (bitnami-labs/sealed-secrets)
#    - External Secrets Operator (external-secrets.io)

apiVersion: v1
kind: Secret
metadata:
  name: db-backup-secrets
  namespace: db-backup
  labels:
    app.kubernetes.io/name: db-backup
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  # API Configuration
  # Generate with: openssl rand -base64 32
  JWT_SECRET: "${JWT_SECRET}"

  # AWS S3 Credentials
  # Get from AWS IAM console
  AWS_ACCESS_KEY_ID: "${AWS_ACCESS_KEY_ID}"
  AWS_SECRET_ACCESS_KEY: "${AWS_SECRET_ACCESS_KEY}"

  # Database Credentials - PostgreSQL
  POSTGRES_HOST: "${POSTGRES_HOST:-postgres.database.svc.cluster.local}"
  POSTGRES_PORT: "${POSTGRES_PORT:-5432}"
  POSTGRES_USER: "${POSTGRES_USER}"
  POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"

  # Database Credentials - MySQL
  MYSQL_HOST: "${MYSQL_HOST:-mysql.database.svc.cluster.local}"
  MYSQL_PORT: "${MYSQL_PORT:-3306}"
  MYSQL_USER: "${MYSQL_USER}"
  MYSQL_PASSWORD: "${MYSQL_PASSWORD}"

  # Database Credentials - MongoDB
  # Format: mongodb://user:password@host:port/?authSource=admin
  MONGODB_URI: "${MONGODB_URI}"

  # Encryption Keys
  # Generate with: openssl rand -base64 32 | cut -c1-32
  ENCRYPTION_KEY: "${ENCRYPTION_KEY}"

  # Webhook Secret
  # Generate with: openssl rand -hex 32
  WEBHOOK_SECRET: "${WEBHOOK_SECRET}"

  # Vault Integration (if using HashiCorp Vault)
  VAULT_ADDR: "${VAULT_ADDR:-https://vault.vault.svc.cluster.local:8200}"
  VAULT_TOKEN: "${VAULT_TOKEN}"

---
apiVersion: v1
kind: Secret
metadata:
  name: db-backup-tls
  namespace: db-backup
  labels:
    app.kubernetes.io/name: db-backup
    app.kubernetes.io/component: tls
type: kubernetes.io/tls
stringData:
  # TLS Certificate and Key for HTTPS
  # Generate with:
  #   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
  #     -keyout tls.key -out tls.crt \
  #     -subj "/CN=db-backup.example.com/O=YourOrg"
  #
  # For production, use cert-manager or cloud provider certificates
  tls.crt: |
    ${TLS_CERT}
  tls.key: |
    ${TLS_KEY}
