#compdef db-backup dbb dbbackup
# Zsh completion script for db-backup
# Supports oh-my-zsh and intelligent context-aware suggestions

# ============================================================================
# Cache Configuration
# ============================================================================

typeset -g _DB_BACKUP_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/db-backup/completion"
typeset -g _DB_BACKUP_CACHE_TTL=300

# ============================================================================
# Helper Functions
# ============================================================================

_db_backup_cache_file() {
    echo "${_DB_BACKUP_CACHE_DIR}/$1.cache"
}

_db_backup_cache_valid() {
    local cache_file="$1"

    [[ ! -f "$cache_file" ]] && return 1

    local cache_time=$(stat -f %m "$cache_file" 2>/dev/null || stat -c %Y "$cache_file" 2>/dev/null)
    local current_time=$(date +%s)
    local age=$((current_time - cache_time))

    [[ $age -gt $_DB_BACKUP_CACHE_TTL ]] && return 1

    return 0
}

_db_backup_cache_read() {
    local cache_file="$1"

    if _db_backup_cache_valid "$cache_file"; then
        cat "$cache_file"
        return 0
    fi

    return 1
}

_db_backup_cache_write() {
    local key="$1"
    local data="$2"

    mkdir -p "$_DB_BACKUP_CACHE_DIR"
    local cache_file=$(_db_backup_cache_file "$key")
    echo "$data" > "$cache_file"
}

_db_backup_exec() {
    local cmd="$1"
    local cache_key="$2"

    local cache_file=$(_db_backup_cache_file "$cache_key")

    # Try cache first
    local cached
    if cached=$(_db_backup_cache_read "$cache_file"); then
        echo "$cached"
        return 0
    fi

    # Execute command
    local result
    if result=$(eval "$cmd" 2>/dev/null); then
        _db_backup_cache_write "$cache_key" "$result"
        echo "$result"
        return 0
    fi

    return 1
}

