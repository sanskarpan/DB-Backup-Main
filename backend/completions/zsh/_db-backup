_db_backup_databases() {
    local databases
    databases=($(_db_backup_exec "db-backup database list --format=name" "databases"))
    _describe 'database' databases
}

_db_backup_backups() {
    local database="$1"
    local backups cmd

    if [[ -n "$database" ]]; then
        cmd="db-backup backup list --database='$database' --format=id"
        backups=($(_db_backup_exec "$cmd" "backups_$database"))
    else
        backups=($(_db_backup_exec "db-backup backup list --format=id" "backups_all"))
    fi

    _describe 'backup' backups
}

