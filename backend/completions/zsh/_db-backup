# ============================================================================
# Main Completion Function
# ============================================================================

_db-backup() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '1: :_db_backup_commands' \
        '*::arg:->args'

    case $state in
        args)
            case $words[1] in
                backup)
                    _db_backup_backup
                    ;;
                restore)
                    _db_backup_restore
                    ;;
                database)
                    _db_backup_database
                    ;;
                schedule)
                    _db_backup_schedule
                    ;;
                retention)
                    _db_backup_retention
                    ;;
                monitoring)
                    _db_backup_monitoring
                    ;;
                compliance)
                    _db_backup_compliance
                    ;;
                policy)
                    _db_backup_policy
                    ;;
                encryption)
                    _db_backup_encryption
                    ;;
                catalog)
                    _db_backup_catalog
                    ;;
                tag)
                    _db_backup_tag
                    ;;
                export)
                    _db_backup_export
                    ;;
                import)
                    _db_backup_import
                    ;;
                health)
                    _db_backup_health
                    ;;
                version|help)
                    # No further completion needed
                    ;;
            esac
            ;;
    esac
}

