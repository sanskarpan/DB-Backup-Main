#!/usr/bin/env bash
# ==============================================================================
# DB Backup Manager - Advanced Bash Completion
# ==============================================================================
# Features: Fuzzy matching, history, learning, preview, templates, plugins
# ==============================================================================

# Configuration
_DB_BACKUP_ADVANCED_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/db-backup/completion"
_DB_BACKUP_CACHE_DIR="$_DB_BACKUP_ADVANCED_DIR/cache"
_DB_BACKUP_HISTORY_FILE="$_DB_BACKUP_ADVANCED_DIR/history.json"
_DB_BACKUP_CACHE_TTL=300 # 5 minutes

# Colors for preview mode (if terminal supports it)
if [[ -t 1 ]]; then
    _DB_BACKUP_COLOR_RESET='\033[0m'
    _DB_BACKUP_COLOR_BOLD='\033[1m'
    _DB_BACKUP_COLOR_DIM='\033[2m'
    _DB_BACKUP_COLOR_GREEN='\033[32m'
    _DB_BACKUP_COLOR_BLUE='\033[34m'
    _DB_BACKUP_COLOR_YELLOW='\033[33m'
else
    _DB_BACKUP_COLOR_RESET=''
    _DB_BACKUP_COLOR_BOLD=''
    _DB_BACKUP_COLOR_DIM=''
    _DB_BACKUP_COLOR_GREEN=''
    _DB_BACKUP_COLOR_BLUE=''
    _DB_BACKUP_COLOR_YELLOW=''
fi

# ==============================================================================
# Advanced Caching Functions
# ==============================================================================

_db_backup_advanced_cache_get() {
    local key="$1"
    local cache_file="$_DB_BACKUP_CACHE_DIR/$key.cache"

    if [[ -f "$cache_file" ]]; then
        local cache_time=$(stat -f %m "$cache_file" 2>/dev/null || stat -c %Y "$cache_file" 2>/dev/null)
        local current_time=$(date +%s)
        local age=$((current_time - cache_time))

        if [[ $age -lt $_DB_BACKUP_CACHE_TTL ]]; then
            cat "$cache_file"
            return 0
        fi
    fi

    return 1
}

_db_backup_advanced_cache_set() {
    local key="$1"
    local value="$2"
    local cache_file="$_DB_BACKUP_CACHE_DIR/$key.cache"

    mkdir -p "$_DB_BACKUP_CACHE_DIR"
    echo "$value" > "$cache_file"
}

# ==============================================================================
# Fuzzy Matching
# ==============================================================================

_db_backup_fuzzy_match() {
    local query="$1"
    shift
    local candidates=("$@")

    if [[ -z "$query" ]]; then
        printf '%s\n' "${candidates[@]}"
        return
    fi

    local matches=()
    for candidate in "${candidates[@]}"; do
        # Simple fuzzy match: check if all characters in query appear in order
        local remaining="$candidate"
        local matched=true

        for (( i=0; i<${#query}; i++ )); do
            local char="${query:$i:1}"
            if [[ "$remaining" == *"$char"* ]]; then
                remaining="${remaining#*$char}"
            else
                matched=false
                break
            fi
        done

        if [[ "$matched" == true ]]; then
            matches+=("$candidate")
        fi
    done

    printf '%s\n' "${matches[@]}"
}

# ==============================================================================
# History-Based Suggestions
# ==============================================================================

_db_backup_history_suggest() {
    local prefix="$1"
    local history_file="$_DB_BACKUP_HISTORY_FILE"

    if [[ ! -f "$history_file" ]]; then
        return
    fi

    # Extract frequently used commands from history
    # This is a simplified version - full implementation in Go
    local suggestions=$(grep -i "^$prefix" "$history_file" 2>/dev/null | head -5)
    echo "$suggestions"
}

# ==============================================================================
# Preview Mode
# ==============================================================================

_db_backup_show_preview() {
    local command="$1"
    shift
    local args=("$@")

    # Check if preview mode is enabled
    if [[ "${DB_BACKUP_PREVIEW_MODE:-1}" != "1" ]]; then
        return
    fi

    # Show preview for templates
    if [[ "${args[*]}" == *"--template"* ]]; then
        local template_name="${args[-1]}"
        echo -e "${_DB_BACKUP_COLOR_DIM}Preview: Template '$template_name'${_DB_BACKUP_COLOR_RESET}" >&2
    fi

    # Show preview for commands
    case "$command" in
        backup)
            echo -e "${_DB_BACKUP_COLOR_DIM}Will create a backup${_DB_BACKUP_COLOR_RESET}" >&2
            ;;
        restore)
            echo -e "${_DB_BACKUP_COLOR_YELLOW}⚠  Will restore database - use with caution${_DB_BACKUP_COLOR_RESET}" >&2
            ;;
    esac
}

# ==============================================================================
# Template Suggestions
# ==============================================================================

_db_backup_template_list() {
    local templates=(
        "full-backup:Full backup with compression and encryption"
        "incremental-backup:Incremental backup"
        "restore-latest:Restore from latest backup"
        "point-in-time-restore:Restore to specific point in time"
        "daily-schedule:Create daily backup schedule"
        "compliance-scan:Run compliance scan"
    )

    for template in "${templates[@]}"; do
        echo "${template%%:*}"
    done
}

_db_backup_template_preview() {
    local template_name="$1"

    case "$template_name" in
        full-backup)
            echo "db-backup backup create --database production-db --type full --compression gzip --encryption aes-256-gcm --provider s3"
            ;;
        incremental-backup)
            echo "db-backup backup create --database production-db --type incremental --compression zstd --provider s3"
            ;;
        restore-latest)
            echo "db-backup restore full --database production-db --backup latest --target staging-db"
            ;;
        *)
            echo "Template: $template_name"
            ;;
    esac
}

# ==============================================================================
# Syntax Highlighting Hints
# ==============================================================================

_db_backup_highlight_suggestion() {
    local suggestion="$1"
    local source="$2"

    case "$source" in
        history)
            echo -e "${_DB_BACKUP_COLOR_GREEN}✓${_DB_BACKUP_COLOR_RESET} $suggestion ${_DB_BACKUP_COLOR_DIM}(from history)${_DB_BACKUP_COLOR_RESET}"
            ;;
        template)
            echo -e "${_DB_BACKUP_COLOR_BLUE}📝${_DB_BACKUP_COLOR_RESET} $suggestion ${_DB_BACKUP_COLOR_DIM}(template)${_DB_BACKUP_COLOR_RESET}"
            ;;
        plugin)
            echo -e "${_DB_BACKUP_COLOR_YELLOW}🔌${_DB_BACKUP_COLOR_RESET} $suggestion ${_DB_BACKUP_COLOR_DIM}(plugin)${_DB_BACKUP_COLOR_RESET}"
            ;;
        *)
            echo "$suggestion"
            ;;
    esac
}

# ==============================================================================
# Project-Specific Completions
# ==============================================================================

_db_backup_load_project_config() {
    local current_dir="$PWD"

    # Look for .db-backup-completion.json in current directory or parents
    while [[ "$current_dir" != "/" ]]; do
        if [[ -f "$current_dir/.db-backup-completion.json" ]]; then
            # Load project-specific completions
            export DB_BACKUP_PROJECT_CONFIG="$current_dir/.db-backup-completion.json"
            return 0
        fi
        current_dir="$(dirname "$current_dir")"
    done

    return 1
}

# ==============================================================================
# Main Completion Function with Advanced Features
# ==============================================================================

_db_backup_advanced_completion() {
    local cur prev words cword
    _init_completion || return

    # Load project-specific config
    _db_backup_load_project_config

    local command=""
    if [[ $cword -gt 0 ]]; then
        command="${words[1]}"
    fi

    # Record completion attempt for analytics
    local start_time=$(date +%s%N 2>/dev/null || date +%s)

    # Try history-based suggestions first
    local history_suggestions=$(_db_backup_history_suggest "$cur")
    if [[ -n "$history_suggestions" ]]; then
        COMPREPLY=($(compgen -W "$history_suggestions" -- "$cur"))
        return 0
    fi

    # Check for template flag
    if [[ "$prev" == "--template" || "$cur" == "--template"* ]]; then
        local templates=$(_db_backup_template_list)
        COMPREPLY=($(compgen -W "$templates" -- "$cur"))

        # Show preview for first suggestion
        if [[ ${#COMPREPLY[@]} -gt 0 ]]; then
            local preview=$(_db_backup_template_preview "${COMPREPLY[0]}")
            echo -e "\n${_DB_BACKUP_COLOR_DIM}Preview: $preview${_DB_BACKUP_COLOR_RESET}" >&2
        fi

        return 0
    fi

    # Fall back to standard completions with fuzzy matching
    local candidates=("backup" "restore" "database" "schedule" "retention" "monitoring" "compliance")

    if [[ -z "$command" ]]; then
        # Fuzzy match commands
        local fuzzy_matches=$(_db_backup_fuzzy_match "$cur" "${candidates[@]}")
        COMPREPLY=($(compgen -W "$fuzzy_matches" -- "$cur"))
    else
        # Command-specific completions
        case "$command" in
            backup)
                local subcommands="create list delete download restore verify info cleanup stats"
                COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
                ;;
            restore)
                local subcommands="full incremental differential pitr table"
                COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
                ;;
            *)
                # Default flag completions
                COMPREPLY=($(compgen -W "--help --version --config --verbose --quiet" -- "$cur"))
                ;;
        esac
    fi

    # Show preview for dangerous commands
    _db_backup_show_preview "$command" "${words[@]}"

    # Calculate response time
    local end_time=$(date +%s%N 2>/dev/null || date +%s)
    local response_time=$((end_time - start_time))

    return 0
}

# ==============================================================================
# Keybindings for Advanced Features
# ==============================================================================

# Ctrl-X Ctrl-P: Show preview
bind -x '"\C-x\C-p": _db_backup_preview_current_command'

_db_backup_preview_current_command() {
    local current_line="$READLINE_LINE"
    echo ""
    echo -e "${_DB_BACKUP_COLOR_BOLD}Preview:${_DB_BACKUP_COLOR_RESET}"
    echo -e "${_DB_BACKUP_COLOR_DIM}$current_line${_DB_BACKUP_COLOR_RESET}"
    echo ""
}

# Ctrl-X Ctrl-H: Show history
bind -x '"\C-x\C-h": _db_backup_show_history'

_db_backup_show_history() {
    echo ""
    echo -e "${_DB_BACKUP_COLOR_BOLD}Recent commands:${_DB_BACKUP_COLOR_RESET}"
    _db_backup_history_suggest "" | head -10
    echo ""
}

# ==============================================================================
# Register Completion
# ==============================================================================

complete -F _db_backup_advanced_completion db-backup
complete -F _db_backup_advanced_completion dbb
complete -F _db_backup_advanced_completion dbbackup

# ==============================================================================
# Initialization
# ==============================================================================

# Create data directory
mkdir -p "$_DB_BACKUP_ADVANCED_DIR"
mkdir -p "$_DB_BACKUP_CACHE_DIR"

# Initialize history file if it doesn't exist
if [[ ! -f "$_DB_BACKUP_HISTORY_FILE" ]]; then
    echo "[]" > "$_DB_BACKUP_HISTORY_FILE"
fi

# Print loaded message
if [[ "${DB_BACKUP_COMPLETION_QUIET:-0}" != "1" ]]; then
    echo -e "${_DB_BACKUP_COLOR_GREEN}✓${_DB_BACKUP_COLOR_RESET} DB Backup advanced completions loaded" >&2
    echo -e "${_DB_BACKUP_COLOR_DIM}  Features: fuzzy matching, history, templates, preview${_DB_BACKUP_COLOR_RESET}" >&2
    echo -e "${_DB_BACKUP_COLOR_DIM}  Keybindings: Ctrl-X Ctrl-P (preview), Ctrl-X Ctrl-H (history)${_DB_BACKUP_COLOR_RESET}" >&2
fi
